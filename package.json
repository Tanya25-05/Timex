{
  "name": "chrome-extension-timer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:extension": "vite build && npm run copy-files",
    "copy-files": "copy manifest.json dist\\ && copy src\\background.js dist\\src\\ && copy src\\content.js dist\\src\\ && xcopy public dist\\public\\ /E /I /Y",
    "preview": "vite preview",
    "lint": "eslint .",
    "clean": "rmdir /s /q dist"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "eslint": "^9.9.0",
    "globals": "^15.9.0",
    "vite": "^5.4.1"
  }
}
